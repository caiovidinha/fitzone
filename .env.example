# NextAuth
AUTH_SECRET=

# Backend URL (FastAPI)
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Bunny.net (usado pelo backend, mas pode ser necessário no frontend para uploads diretos)
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=your-pullzone.b-cdn.net

# Mock mode — teste sem backend
# Defina como "true" para que as configurações da plataforma sejam lidas/salvas no localStorage.
# Remova (ou defina como "false") ao conectar o backend real.
NEXT_PUBLIC_USE_MOCK_API=false
